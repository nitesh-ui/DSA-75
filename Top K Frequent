function topKFrequent(nums, k) {
    const map = new Map();
    
    for(num of nums) {
        map.set(num, (map.get(num) || 0) + 1);
    }
    const sorted = [...map.entries()].sort((a, b) => b[1] - a[1]);
    
    return sorted.slice(0, k).map(entry => entry[0])
}
console.log(topKFrequent([1,1,1,2,2,3], 2));
