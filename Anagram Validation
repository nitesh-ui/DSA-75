function isAnagram(s, t) {
    if(s.length !== t.length) {
        return false;
    }
    
    const map = new Map();
    
    for(let char of s) {
        map.set(char, (map.get(char) || 0) + 1);
    }
    
    for(let char of t) {
        if(!map.get(char)) {
            return false;
        }
        map.set(char, (map.get(char) || 0) + 1);
    }
    
    return true;
}

console.log(isAnagram('cat', 'tac')); // true
