function containsDuplicate(nums) {
    const set = new Set();
    const duplicateNumbers = new Set();
    
    for(let num of nums) {
        if(set.has(num)) {
            duplicateNumbers.add(num);
            // return true;
        }
        set.add(num)
    }
    // return false;
    return [...duplicateNumbers]
}

console.log(containsDuplicate([1,2,3,1]));
output = [1];
