nums = [3,2,4];
target = 6;

function twoSum(nums, target) {
    const map = new Map();
    for(let i = 0; i < nums.length; i++) {
        const needed = target - nums[i];
        if(map.has(needed)) {
            return [map.get(needed), i];
        }
        map.set(nums[i], i)
    }
}
console.log(twoSum([3,2,4], 6));
